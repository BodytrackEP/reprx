# Copy to .env.local. Never commit real values.
# Local values come from `pnpm exec supabase status`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: never prefix with NEXT_PUBLIC_. Mark as Sensitive in Vercel.
SUPABASE_SECRET_KEY=

# Direct Postgres connection used by `pnpm seed:test` only.
SUPABASE_DB_URL=
